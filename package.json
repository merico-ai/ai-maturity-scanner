{
  "name": "@merico-ai/maturity-scanner",
  "version": "1.0.0",
  "description": "Scan a code repository and report its AI coding maturity (level L0-L4 + AMI score). Standalone CLI, no server, no database.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "ai-maturity-scanner": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "audit:profiles": "node --experimental-strip-types scripts/audit-profiles.ts",
    "demo:image": "npm run build && node scripts/render-image-demo.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "prepublishOnly": "npm test && npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "ai",
    "maturity",
    "claude-code",
    "cursor",
    "copilot",
    "agents",
    "skills",
    "cli",
    "scanner"
  ],
  "license": "MIT",
  "author": "Merico AI",
  "repository": {
    "type": "git",
    "url": "https://github.com/merico-ai/ai-maturity-scanner.git"
  },
  "homepage": "https://github.com/merico-ai/ai-maturity-scanner#readme",
  "bugs": {
    "url": "https://github.com/merico-ai/ai-maturity-scanner/issues"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "minimatch": "^10.2.5",
    "picocolors": "^1.1.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "smol-toml": "^1.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
